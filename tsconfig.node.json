{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "composite": true,
    "noEmit": true,

    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",

    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",

    "strict": true,
    "skipLibCheck": true,

    "jsx": "react-jsx",
    "types": ["node"],
  },
  "include": ["vite.config.ts", "vitest.config.ts", ".storybook/**/*"]
}
