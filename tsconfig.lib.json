{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    
    "composite": true,
    "noEmit": false,
    
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,

    "outDir": "./dist/types",
    "rootDir": "./src",

    "stripInternal": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/**/*.test.*",
    "src/**/*.stories.*",
    "src/setupTests.*",
    "src/main.*",
    "src/App.*",
    ".storybook/**",
    "stories/**",
    "docs/**",
    "dist/**",
    "node_modules/**"
  ]
}
